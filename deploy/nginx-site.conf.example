# Add one virtual host to the EXISTING nginx http context.
# Replace domain and certificate paths first. Never overwrite nginx.conf.
# Obtain/renew the certificate with the host's established ACME process.
server {
    listen 80;
    server_name demo.example.invalid;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name demo.example.invalid;
    ssl_certificate /etc/letsencrypt/live/demo.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    access_log /var/log/nginx/onstage.access.log;
    error_log /var/log/nginx/onstage.error.log warn;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # This proxy is the only trusted source of the client address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_connect_timeout 5s;
        proxy_buffering off;
    }
}
